# Copy to .env and adjust. Validated at startup by src/config/env.schema.ts.
# Later tasks add their own variables (DATABASE_URL in PC-103, JWT secrets in PC-203, ...).

# development | test | staging | production
NODE_ENV=development

# Port the API listens on
PORT=3000

# Global route prefix: routes are served at /<API_PREFIX>/v1/...
API_PREFIX=api

# Comma-separated origins allowed by CORS (the admin web panel). Empty = CORS off.
CORS_ORIGINS=http://localhost:5173
